# ---------------------------------------------------------------
# Cloud Supabase (production)
# Copy to .env and fill in from: supabase.com → Project Settings → API
# ---------------------------------------------------------------
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Local Supabase (development)
# Copy to .env.local — values printed by: supabase start
# ---------------------------------------------------------------
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
